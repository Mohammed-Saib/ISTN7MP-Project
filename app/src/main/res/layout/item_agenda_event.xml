<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda row for a CalendarEvent. Left strip coloured by event type. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp">

        <!-- Left strip — width/color set in AgendaAdapter -->
        <View
            android:id="@+id/view_type_strip"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/event_lecture"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Event title -->
        <TextView
            android:id="@+id/tv_event_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/iv_recurring"
            app:layout_constraintStart_toEndOf="@id/view_type_strip"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Date — shown in list/upcoming mode, hidden in day-agenda mode -->
        <TextView
            android:id="@+id/tv_event_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/tv_event_title"
            app:layout_constraintStart_toStartOf="@id/tv_event_title"
            app:layout_constraintTop_toBottomOf="@id/tv_event_title" />

        <!-- Time range or "All day" -->
        <TextView
            android:id="@+id/tv_event_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/tv_event_title"
            app:layout_constraintStart_toStartOf="@id/tv_event_title"
            app:layout_constraintTop_toBottomOf="@id/tv_event_date" />

        <!-- Module name chip — GONE if no module linked; text set by AgendaAdapter from module map -->
        <TextView
            android:id="@+id/tv_event_module"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_surface"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tv_event_title"
            app:layout_constraintTop_toBottomOf="@id/tv_event_time" />

        <!-- Barrier at the bottom of the lowest content view (module if visible, else time/title) -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_content_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_event_title,tv_event_time,tv_event_module" />

        <!-- Space provides the 12dp bottom padding; drives the ConstraintLayout's wrap_content height -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@id/barrier_content_bottom" />

        <!-- Recurring indicator — shown only when event belongs to a series -->
        <ImageView
            android:id="@+id/iv_recurring"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Recurring"
            android:src="@drawable/ic_repeat"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
