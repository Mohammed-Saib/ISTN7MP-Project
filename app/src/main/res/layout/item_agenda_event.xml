<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda row for a CalendarEvent. Left strip is coloured by event type. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal">

        <!-- Coloured type strip — width/color set in AgendaAdapter -->
        <View
            android:id="@+id/view_type_strip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/event_lecture" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Event title -->
            <TextView
                android:id="@+id/tv_event_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Time range or "All day" -->
            <TextView
                android:id="@+id/tv_event_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:alpha="0.7" />

            <!-- Module name chip (hidden if not linked) -->
            <TextView
                android:id="@+id/tv_event_module"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded_surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right side: recurring icon + type badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_recurring"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Recurring"
                android:src="@drawable/ic_repeat"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_event_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
