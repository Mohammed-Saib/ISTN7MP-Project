<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardResearchPaper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtPaperTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paper Title"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtPaperMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authors • Year"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/txtPaperCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/txtPaperSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summary preview..."
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtPaperStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unread"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_chip_soft"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>