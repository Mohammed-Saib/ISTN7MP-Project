<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda row for a Todo that has a due date. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">

        <!-- Priority strip (full height) — color set to HIGH/MEDIUM/LOW in AgendaAdapter -->
        <View
            android:id="@+id/view_priority_strip"
            android:layout_width="4dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Completion checkbox — vertically centered in the card -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_priority_strip"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_todo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cb_todo"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Due time — shown only if a specific time was set (not midnight) -->
        <TextView
            android:id="@+id/tv_todo_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/tv_todo_title"
            app:layout_constraintStart_toStartOf="@id/tv_todo_title"
            app:layout_constraintTop_toBottomOf="@id/tv_todo_title" />

        <!-- Module name chip — GONE if no module linked; text set by AgendaAdapter from module map -->
        <TextView
            android:id="@+id/tv_todo_module"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rounded_surface"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tv_todo_title"
            app:layout_constraintTop_toBottomOf="@id/tv_todo_time" />

        <!-- Barrier at the bottom of the lowest content view -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_content_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_todo_title,tv_todo_time,tv_todo_module" />

        <!-- Space provides the 12dp bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@id/barrier_content_bottom" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
