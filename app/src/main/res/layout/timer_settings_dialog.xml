<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Timer Settings"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Focus time -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Time (minutes)" />
    <SeekBar
        android:id="@+id/seekFocus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="60"
        android:progress="25" />
    <TextView
        android:id="@+id/lblFocus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25 min"
        android:layout_marginBottom="16dp" />

    <!-- Short break -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Short Break (minutes)" />
    <SeekBar
        android:id="@+id/seekShort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="30"
        android:progress="5" />
    <TextView
        android:id="@+id/lblShort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 min"
        android:layout_marginBottom="16dp" />

    <!-- Long break -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Long Break (minutes)" />
    <SeekBar
        android:id="@+id/seekLong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="60"
        android:progress="15" />
    <TextView
        android:id="@+id/lblLong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15 min"
        android:layout_marginBottom="16dp" />

    <!-- Sessions before long break -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sessions before Long Break" />
    <SeekBar
        android:id="@+id/seekSessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="8"
        android:progress="4" />
    <TextView
        android:id="@+id/lblSessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4 sessions"
        android:layout_marginBottom="24dp" />

    <!-- Background/Character picker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Background Theme"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/radioCat_lm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cat - Light Mode"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioCat_dm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cat - Dark Mode" />

        <RadioButton
            android:id="@+id/radioSnoopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snoopy" />

    </RadioGroup>

    <!-- Save button -->
    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE"
        android:backgroundTint="#3A5F8F"
        android:textColor="#FFFFFF" />

</LinearLayout>