<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <!-- ── Scrollable body (top bars + grid + agenda) ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- ── Row 1: App title + view controls (always visible) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_calendar"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Toggle between calendar grid and upcoming list -->
                <ImageButton
                    android:id="@+id/btn_toggle_view"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="Toggle list view"
                    android:src="@drawable/ic_view_list"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- ── Row 2: Month navigation (hidden in list mode) ── -->
            <LinearLayout
                android:id="@+id/ll_month_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="10dp">

                <ImageButton
                    android:id="@+id/btn_prev_month"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="Previous month"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnSurface" />

                <!-- Month + year label — centred between the chevrons -->
                <TextView
                    android:id="@+id/tv_month_year"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="May 2026" />

                <ImageButton
                    android:id="@+id/btn_next_month"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="Next month"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- ── Calendar section: grid + day headers (hidden in list mode) ── -->
            <LinearLayout
                android:id="@+id/ll_calendar_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Day-of-week header row (Sun–Sat) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView style="@style/CalDayHeader" android:text="S" />
                    <TextView style="@style/CalDayHeader" android:text="M" />
                    <TextView style="@style/CalDayHeader" android:text="T" />
                    <TextView style="@style/CalDayHeader" android:text="W" />
                    <TextView style="@style/CalDayHeader" android:text="T" />
                    <TextView style="@style/CalDayHeader" android:text="F" />
                    <TextView style="@style/CalDayHeader" android:text="S" />
                </LinearLayout>

                <!-- Month grid — GridLayoutManager(7) set in CalendarFragment -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_calendar_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Divider between grid and agenda -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutline" />

            </LinearLayout>

            <!-- Agenda section header — updated to selected day label -->
            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Today, 17 May" />

            <!-- Search field — visible only in list/upcoming mode -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_search_list"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:hint="Search events…"
                android:visibility="gone"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Empty state for agenda -->
            <TextView
                android:id="@+id/tv_no_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_rounded_surface"
                android:gravity="center"
                android:padding="20dp"
                android:text="Nothing scheduled"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Agenda list — non-scrolling inside NestedScrollView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_day_agenda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB to add a new event -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="Add Event"
        app:icon="@drawable/ic_add"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MPProject.FAB" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
